http {
    # ... your existing settings (include, default_type, etc.) ...

    # ==============================================
    # GZIP Compression Configuration
    # ==============================================

    # Enable GZIP compression
    gzip on;

    # Enable compression for HTTP/1.0 and HTTP/1.1
    gzip_http_version 1.0;

    # Compression level (1-9, where 9 is highest compression but uses more CPU)
    # Level 5 is a good balance between compression and CPU usage
    gzip_comp_level 5;

    # Minimum file size to compress (avoid compressing very small files)
    gzip_min_length 256;

    # Buffer size for compression
    gzip_buffers 16 8k;

    # File types to compress
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        text/markdown
        application/javascript
        application/x-javascript
        application/json
        application/xml
        application/rss+xml
        application/atom+xml
        application/ld+json
        application/manifest+json
        application/x-web-app-manifest+json
        image/svg+xml
        font/ttf
        font/otf
        font/x-woff
        font/woff
        font/woff2
        image/x-icon
        image/vnd.microsoft.icon
        image/bmp;

    # Disable compression for Internet Explorer 6 (doesn't support it properly)
    gzip_disable "msie6";

    # Add Vary: Accept-Encoding header (helps with caching)
    gzip_vary on;

    # Proxied requests compression
    gzip_proxied any;

    # ==============================================
    # Your existing server blocks continue below
    # ==============================================
    server {
      #listen ${REACT_WEB_PORT};
      listen {NGINX_PORT:-80};
      server_name ${SERVER_NAME:-192.168.64.1};
      root /usr/share/nginx/html;
      index index.html;
      etag on;
      # Add Docker's internal DNS resolver
      resolver 127.0.0.11 valid=30s;

      location / {
          try_files $uri $uri/ /index.html;
      }

      # API requests - using regex to strip /api and preserve query params
      location ~ ^/api/(.*) {
          proxy_pass http://iws-api:8080/$1$is_args$args;
          proxy_http_version 1.1;
          proxy_set_header Connection "upgrade";
          proxy_set_header Host $host;
          proxy_cache_bypass $http_upgrade;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          expires off;
          add_header Cache-Control "no-cache, no-store, must-revalidate";
      }

     location ~* \.(jpg|jpeg|png|gif|ico|css|js)$ {
         expires 30d;
         add_header Cache-Control "public, immutable";
     }
      # Cache static assets
      location /static {
          expires 1y;
          add_header Cache-Control "public, immutable";
      }

      error_page 500 502 503 504 /50x.html;
      location = /50x.html {
        root /usr/share/nginx/html;
      }
    }
}
