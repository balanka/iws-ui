server {
    #listen ${REACT_WEB_PORT};
    listen {NGINX_PORT:-80};
    server_name ${SERVER_NAME:-192.168.64.1};
    root /usr/share/nginx/html;
    index index.html;
    etag on;
    # Add Docker's internal DNS resolver
     resolver 127.0.0.11 valid=30s;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API requests - using regex to strip /api and preserve query params
    location ~ ^/api/(.*) {
        proxy_pass http://iws-api:8080/$1$is_args$args;
        proxy_http_version 1.1;
        #proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        #proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Cache static assets
    location /static {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    error_pa







    ge 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
