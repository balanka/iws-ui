# ---------- Builder ----------
FROM node:24.3.0-slim AS builder
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install
COPY . .

ARG VITE_APP_BACKEND_ADDRESS
ARG REACT_APP_HOST_IP_ADDRESS
ARG REACT_APP_PORT
ARG REACT_WEB_HOST_IP_ADDRESS
ARG REACT_WEB_PORT
ENV VITE_APP_BACKEND_ADDRESS=$VITE_APP_BACKEND_ADDRESS \
    REACT_APP_HOST_IP_ADDRESS=$REACT_APP_HOST_IP_ADDRESS \
    REACT_APP_PORT=$REACT_APP_PORT \
    REACT_WEB_HOST_IP_ADDRESS=$REACT_WEB_HOST_IP_ADDRESS \
    REACT_WEB_PORT=$REACT_WEB_PORT

RUN npm run build   

# ---------- Production ----------
FROM nginx:1.29-alpine-slim AS prod

# ✅ Cleanup goes in the prod stage (where nginx actually exists)
RUN rm -rf /usr/share/nginx/html/* \
    && rm -f /etc/nginx/conf.d/default.conf \
    && rm -f /docker-entrypoint.d/10-listen-on-ipv6-by-default.sh \
             /docker-entrypoint.d/15-local-resolvers.envsh \
             /docker-entrypoint.d/20-envsubst-on-templates.sh \
    && rm -rf /var/log/nginx/* /usr/share/doc /usr/share/man

# Copy built SPA
COPY --chown=nginx:nginx --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config template
COPY nginx.conf.template /etc/nginx/conf.d/

# Custom env substitution script
COPY env.sh /docker-entrypoint.d/env.sh
RUN chmod +x /docker-entrypoint.d/env.sh

CMD ["nginx", "-g", "daemon off;"]
